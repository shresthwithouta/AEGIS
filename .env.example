# AEGIS — configuration
#
# Everything is optional. With no configuration at all the command centre runs
# fully on its deterministic rule engines and labels every recommendation
# RULE ENGINE on screen. That is a supported operating mode, not a broken one.

# --- Reasoning layer -------------------------------------------------------
# Enables stage 4's reasoned recommendation. The model investigates zones and
# routes through read-only tools before proposing an allocation, and everything
# it produces is labelled REASONED in the interface.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Vision service --------------------------------------------------------
# Points stage 1 at the Python U-Net + YOLOv8 service in services/vision.
# The pipeline probes /health on every run and falls back to the incident model
# when the service is unreachable — it never blocks on it.
# VISION_SERVICE_URL=http://localhost:8000
# VISION_SERVICE_TIMEOUT_MS=20000
